# =====================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO STOCK AI COPILOT & TRADING BOT
# =====================================================================

# 1. Google Gemini API Key (Bắt buộc để chạy AI Analyst)
GEMINI_API_KEY="your_gemini_api_key_here"

# 2. Discord Webhook URL (Bắn báo cáo tổng hợp vào kênh chung / group)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your_webhook_url"

# 3. Discord Bot Token & User ID (Bắn tín hiệu Mua/Bán riêng vào DM bảo mật)
DISCORD_BOT_TOKEN="your_discord_bot_token"
DISCORD_USER_ID="your_discord_user_id"

# 4. Vnstock API Key (Tùy chọn, để trống nếu dùng gói cộng đồng miễn phí)
VNSTOCK_API_KEY=""

# 5. Link Google Sheet Đồng Bộ Danh Mục (Tùy chọn)
# Để trống nếu muốn dùng file portfolio.json và watchlist.json cục bộ
# Nếu có: Chia sẻ file Google Sheet với quyền "Bất kỳ ai có liên kết đều xem được"
GOOGLE_SHEET_URL=""
GOOGLE_SHEET_UPDATE_URL=""
