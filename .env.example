# === Required ===
GEMINI_API_KEY="your_gemini_api_key"

# === Discord Alerts (optional) ===
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
DISCORD_BOT_TOKEN="your_discord_bot_token"
DISCORD_USER_ID="your_discord_user_id"

# === Google Sheets Sync (optional — leave empty to use local JSON files) ===
GOOGLE_SHEET_URL=""
GOOGLE_SHEET_UPDATE_URL=""

# === Environment Setting ===
# APP_ENV: "development", "testing", or "production"
# Live database writes to production tables are STRICTLY BLOCKED unless APP_ENV="production".
APP_ENV="development"

# === Supabase — Signal Audit Database ===
# FOR DEV/TESTING: Use a dedicated dev project/schema with separate credentials!
# NEVER put production SUPABASE_KEY on local development machines.
SUPABASE_DEV_URL=""
SUPABASE_DEV_KEY=""

# PRODUCTION ONLY (deploy server only):
SUPABASE_URL="https://xxx.supabase.co"
SUPABASE_KEY="your_supabase_anon_key"

# === Vnstock API (optional) ===
VNSTOCK_API_KEY=""

